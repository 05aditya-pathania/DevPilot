@(
    "# Dependencies",
    "**/node_modules/",
    "",
    "# Environment files",
    "**/.env",
    "",
    "# Build output",
    "**/dist/",
    "",
    "# Logs",
    "npm-debug.log*",
    "yarn-debug.log*",
    "pnpm-debug.log*"
) | Set-Content -Path "D:\MyProject\DevPilot\.gitignore" -Encoding utf8