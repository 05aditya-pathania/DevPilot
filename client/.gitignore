@(
    "# Dependencies"
    "node_modules/"
    "**/node_modules/"
    ""
    "# Environment files"
    ".env"
    "**/.env"
    ""
    "# Build output"
    "dist/"
    "**/dist/"
    ""
    "# Logs"
    "npm-debug.log*"
    "yarn-debug.log*"
    "pnpm-debug.log*"
) | Set-Content -Path ".gitignore" -Encoding utf8